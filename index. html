<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="theme-color" content="#090909">
<title>SINDBAD HOST | PS4 HUB</title>

<style>
*{box-sizing:border-box;margin:0;padding:0}

body{
 min-height:100vh;
 background:
 linear-gradient(rgba(0,0,0,0.7), rgba(0,0,0,0.7)),
 url('img.jpg');
 background-size:cover;
 background-position:center;
 background-repeat:no-repeat;
 color:#fff;
 font-family:Tahoma,Arial,sans-serif;
 display:flex;
 align-items:center;
 justify-content:center;
 padding:22px;
 overflow-x:hidden;
}

body:before{
 content:"";
 position:fixed;
 inset:0;
 background:repeating-linear-gradient(
  135deg,transparent 0px,transparent 45px,
  rgba(255,0,35,.025) 46px,transparent 47px
 );
 pointer-events:none;
}

.container{
 width:100%;
 max-width:430px;
 text-align:center;
 position:relative;
 z-index:1;
}

.brand{
 font-size:32px;
 font-weight:1000;
 letter-spacing:4px;
 color:#fff;
 text-shadow:0 0 20px rgba(255,0,40,.5);
}

.brand span{color:#ff173b}

.tagline{
 margin-top:9px;
 color:#ccc;
 font-size:10px;
 letter-spacing:4px;
}

.line{
 width:75px;
 height:3px;
 border-radius:5px;
 background:#ff173b;
 margin:24px auto 35px;
 box-shadow:0 0 15px #ff173b;
}

.glass{
 width:205px;
 height:205px;
 margin:0 auto 32px;
 border-radius:35px;
 border:1px solid rgba(255,35,65,.7);
 background:linear-gradient(145deg,
 rgba(255,255,255,.12),
 rgba(255,0,35,.035));
 box-shadow:
 0 0 25px rgba(255,0,40,.2),
 0 0 70px rgba(255,0,40,.12),
 inset 0 0 30px rgba(255,0,40,.08);
 backdrop-filter:blur(15px);
 display:flex;
 align-items:center;
 justify-content:center;
 position:relative;
}

.glass:before{
 content:"";
 position:absolute;
 inset:10px;
 border:1px solid rgba(255,255,255,.08);
 border-radius:27px;
}

.logo{
 font-size:65px;
 font-weight:1000;
 color:#ff173b;
 text-shadow:0 0 10px #ff173b,0 0 35px #a50020;
}

.logo small{
 display:block;
 color:#fff;
 font-size:12px;
 letter-spacing:7px;
 margin-top:-4px;
}

h1{
 font-size:24px;
 letter-spacing:2px;
 margin-bottom:10px;
}

h1 span{color:#ff173b}

.description{
 color:#ccc;
 font-size:13px;
 line-height:2;
}

.version{
 margin:25px 0;
 padding:17px;
 border-radius:14px;
 background:rgba(0,0,0,.5);
 border:1px solid rgba(255,30,60,.25);
}

.version label{
 display:block;
 color:#aaa;
 font-size:11px;
 margin-bottom:8px;
}

.version strong{
 font-size:23px;
 color:#ff304e;
 text-shadow:0 0 15px rgba(255,0,40,.4);
}

.launch{
 display:block;
 width:100%;
 padding:18px;
 border-radius:13px;
 background:linear-gradient(120deg,#a90022,#ff173b,#a90022);
 color:white;
 text-decoration:none;
 font-size:17px;
 font-weight:bold;
 letter-spacing:3px;
 box-shadow:0 0 25px rgba(255,0,40,.3);
 transition:.25s;
}

.launch:active{
 transform:scale(.96);
 box-shadow:0 0 35px rgba(255,0,40,.6);
}

.status{
 display:flex;
 justify-content:center;
 align-items:center;
 gap:8px;
 color:#ccc;
 font-size:11px;
 margin-top:18px;
}

.dot{
 width:7px;
 height:7px;
 background:#ff173b;
 border-radius:50%;
 box-shadow:0 0 10px #ff173b;
}

.note{
 color:#aaa;
 font-size:10px;
 line-height:1.9;
 margin-top:22px;
}

footer{
 margin-top:30px;
 padding-top:18px;
 border-top:1px solid #292020;
 color:#aaa;
 font-size:11px;
 line-height:2;
}

footer b{color:#ff304e}

@media(max-width:360px){
 .brand{font-size:26px}
 .glass{width:175px;height:175px}
}
</style>
</head>

<body>
<div class="container">

 <div class="brand">SINDBAD <span>HOST</span></div>
 <div class="tagline">ULTIMATE GAMING EXPERIENCE</div>

 <div class="line"></div>

 <div class="glass">
  <div class="logo">
   S
   <small>HOST</small>
  </div>
 </div>

 <h1>PS4 <span>GOLDHEN</span></h1>
 <p class="description">
  بوابتك الخاصة لأدوات البلايستيشن 4
  <br>
  Powered by SINDBAD HOST
 </p>

 <div class="version">
  <label>FIRMWARE TARGET</label>
  <strong>5.05 - 13.52</strong>
 </div>

 <a class="launch"
 href="https://sindbad-host2.github.io/"
 target="_blank"
 rel="noopener noreferrer">
 START
 </a>

 <div class="status">
  <span class="dot"></span>
  <span>OFFLINE HOST ACTIVE</span>
 </div>

 <p class="note">
  تم تجهيز الهوست للعمل بكفاءة عالية.
  تحقق من توافق إصدار جهازك قبل التشغيل.
 </p>

 <footer>
  <b>SINDBAD HOST</b>
  <br>
  بغداد الجديدة - بجانب سينما البيضاء
  <br>
  © 2026 ALL RIGHTS RESERVED
 </footer>

</div>
</body>
</html>
